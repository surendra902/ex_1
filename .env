POLYMARKET_PRIVATE_KEY=
# [TUNED 2026-07-26] was POLYMARKET_PROXY_ADDRESS=(empty) -- was EMPTY in the repo file; SIGNATURE_TYPE=2 cannot trade without it. Value verified on-chain in the 2026-07-26 log.
POLYMARKET_PROXY_ADDRESS=0xdC115aF17dB9F6DBB54E83B9C1bD661B2B9713d9
# 2 = POLY_GNOSIS_SAFE. Keep 2: validate() refuses live redemption on type 1,
# and live LatArb requires redemption (§13).
POLYMARKET_SIGNATURE_TYPE=2
CLOB_URL=https://clob.polymarket.com
GAMMA_URL=https://gamma-api.polymarket.com
CHAIN_ID=137

# -- 2. Run mode --------------------------------------------------------------
# LIVE. This places real orders with real USDC as soon as the bot boots.
# Set DRY_RUN=true to go back to paper — nothing else needs to change.
# Before the first live start, confirm all four:
#   1. POLYMARKET_PRIVATE_KEY and POLYMARKET_PROXY_ADDRESS are filled in above.
#   2. py-clob-client-v2==1.1.0 is installed (the bot refuses live orders without
#      the V2 SDK, and 1.1.0 is the audited version; the last run had 1.0.1).
#   3. You started via ./run_bot.sh, and the banner reads "Size: $2-$3" and
#      "LatArb: enabled=True". If it reads $2-$25 this file was ignored.
#   4. The wallet is funded. $9.10 works but the loss limits in §9 are only
#      defensible from ~$60 up.
DRY_RUN=false
# Empty = off. Only 1/true/yes/y/on or 0/false/no/n/off parse; anything else is
# a FatalBotError at boot. --measure-only sets this itself.
MEASURE_ONLY=
LOG_LEVEL=INFO
COINS=BTC,ETH,SOL

# -- 3. LatArb decision gates (the only live strategy in this build) ----------
LATENCY_ARB_ENABLED=true
# Edge and min-prob gate BOTH the live FAK and what gets written to the shadow
# CSV. While collecting evidence, record the superset at the code defaults and
# re-score stricter policies offline with --latarb-analyze. Tighten at go-live
# (see the GO-LIVE CHECKLIST at the end of this file).
LATENCY_ARB_EDGE=0.020
LATENCY_ARB_MIN_PROB=0.58
LATENCY_ARB_COOLDOWN_S=2.0
# Depth of the top level must cover 3x the $2 clip.
MIN_TOP_BOOK_USDC=6.0
# LatArb holds to resolution (no exit leg), so spread is not an exit cost —
# 0.10 is the code default and avoids throttling an already rare signal.
MAX_SPREAD_PCT=0.10
# Generic book-freshness fallback (non-LatArb paths and the recheck when the
# LatArb ceiling below is disabled).
MAX_BOOK_AGE_MS=500
# LatArb only ever sends FAK, so this does not touch entries — but the default
# ('maker') makes validate() demand SDK GTD support at live boot and sets
# post_only on any non-FAK order (e.g. a flatten). 'taker' avoids both.
ENTRY_MODE=taker

# -- 4. Shadow evidence log ---------------------------------------------------
LATARB_SHADOW=true
LATARB_SHADOW_PATH=~/latarb_shadow_v1959e.csv
# 0 = no artificial staleness floor; liquid books never clear a floor anyway.
LATARB_SHADOW_MIN_AGE_MS=0
LATARB_SHADOW_THROTTLE_MS=500.0
# HARD live gate, not just a shadow knob: rejects stale books, is re-checked
# before sending, and is passed to om.place() as max_quote_age_ms. Must stay at
# 250 to match LATARB_DUAL_BOOK_STALE_MS; 2000 lets a 2-second-old quote trade.
LATARB_SHADOW_MAX_AGE_MS=250.0

# -- 5. Live proof (unlocks size above the venue minimum) ---------------------
# With REQUIRE_LATARB_LIVE_PROOF=true, live boot needs either passing evidence
# or bootstrap mode. BOOTSTRAP_LIVE=false + no evidence = FatalBotError forever
# (you can never collect live fills), so bootstrap must be true for first live.
REQUIRE_LATARB_LIVE_PROOF=true
LATARB_BOOTSTRAP_LIVE=true
LATARB_MIN_LIVE_ATTEMPTS=50
LATARB_MIN_LIVE_FILL_RATE=0.40
LATARB_MIN_SETTLE_SAMPLES=20
LATARB_MIN_SETTLE_WIN_RATE=0.52
LATARB_MIN_SETTLE_PNL=0.0
# Ledgers the proof reads. Keep the build suffix on all three or the proof
# silently scores an unrelated file.
LATARB_FILLS_PATH=~/latarb_fills_v1959e.jsonl
LATARB_SETTLE_PATH=~/latarb_settle_v1959e.jsonl
# Rolling live kill switch (pauses LatArb on a bad fill rate). Separate knob
# since the E1 rename; module-level, not part of Config.
LATARB_KILL_SWITCH_MIN_FILL_RATE=0.20

# -- 6. Offline analyzer thresholds (--latarb-analyze only) -------------------
# The 200-signal boot gate is gone; these three now only shape the advisory
# report. Per-coin win rate is scored against a dynamic breakeven, not this.
LATARB_MIN_PROVEN_SIGNALS=200
LATARB_MIN_WIN_RATE=0.54
LATARB_MIN_TOTAL_PNL=0.0

# -- 7. Sizing (small wallet) -------------------------------------------------
# Venue minimum is $2.00 in USDC, but each market ALSO carries a share minimum
# (min_order_size, 5.0 shares on every market seen so far). 5 shares cost
# 5 x ask, so the bot must be allowed to spend more than $2.00 whenever the side
# it wants trades above $0.40 -- otherwise it skips with `mos_cap`.
# MEASURED on the operator's 2026-07-25 shadow log (528 scored signals):
#   MAX_ORDER_USDC=2.00 -> 296/528 = 56.1% of all signals unreachable
#   MAX_ORDER_USDC=2.50 ->  69/528 = 13.1%
#   MAX_ORDER_USDC=3.00 ->   9/528 =  1.7%   <-- chosen (covers ask <= 0.600)
#   MAX_ORDER_USDC=3.50 ->   8/528 =  1.5%   (no further gain)
# This is the single biggest reason the bot was not filling trades. It does NOT
# make normal clips bigger: sizing still starts at MIN_ORDER_USDC and only tops
# up to reach a market's share minimum.
# R25 (rev 4): the CLOB floor is 5 SHARES on every market this bot trades
# (min_order_size="5" on btc/eth/sol 5m+15m books, checked live 2026-07-27).
# $2.00 buys 3.8 shares at 0.53 -> guaranteed venue rejection, so the clip
# floor has to cover 5 shares: $3.00 covers prices up to 0.60 outright and up
# to 0.80 by stretching toward MAX_ORDER_USDC. Entries above 0.80 are skipped.
MIN_ORDER_USDC=3.00
# [TUNED 2026-07-26] was MAX_ORDER_USDC=3.0 -- must be >= 2x MIN_ORDER_USDC or Kelly sizing is dead and every order fires at the venue minimum (boot warning in every run). Held at 4.0 = exactly 2x min so it still respects MAX_POSITION_USDC=4.0; the config validator rejects max_order_size > max_position.
MAX_ORDER_USDC=4.0
# Per-market cost cap: needs headroom for one clip (total + needed <= max).
MAX_POSITION_USDC=4.0
# Per-order share of bankroll, and -- more importantly -- the FUNDING FLOOR:
# sizing goes inert when free cash < MIN_ORDER_USDC / MAX_BANKROLL_FRACTION.
#   0.25 -> floor $8.00.  The wallet holds $9.10, so ONE $2 clip dropped free
#           cash to $7.07 and the bot went inert until the position settled.
#           The operator's log shows exactly this, twice:
#           "LATARB_SKIP [bankroll] dry sizing inert: min_order $2.00 >
#            bankroll $7.0672 * frac 0.25"
#   0.50 -> floor $4.00, so two concurrent clips are reachable on $9.10.
# Concurrency is really governed by the exposure caps in §8, not by this knob.
# Lower this back toward 0.25 once the balance is comfortably above $30.
MAX_BANKROLL_FRACTION=0.90

# -- 8. Exposure caps (the canary clamp is gone — these are the only limit) ---
# Effective cap = min(absolute USDC, free balance x bankroll multiplier).
# Caps are checked against order NOTIONAL, while the position books cost+taker
# fee (~1.3% of notional at p=0.55, CATEGORY_FEE_RATE=0.07). Measured run 5:
# a $2.00 clip books $2.026. Sized so the intended clip counts are reachable:
#   net  4.2 = 2 same-direction clips ($4.05 booked)
#   gross 6.3 = 3 concurrent clips    ($6.08 booked)
# [SOAK 2026-07-27] Correlation invariant learned from the 35-min $60 soak:
# BTC/ETH/SOL positions at the SAME expiry take the same directional signal, so
# they lose together. Three settled losing in one second and the give-back from
# a +$9.87 peak tripped the drawdown halt by 4 cents. Hold this invariant when
# you rescale:   MAX_NET_EXPOSURE_USDC  <=  0.75 x MAX_DRAWDOWN_FROM_PEAK
# so one fully correlated round cannot end the session.
MAX_NET_EXPOSURE_USDC=6.0
MAX_GROSS_EXPOSURE_USDC=8.0
MAX_NET_BANKROLL_MULT=1.0
MAX_GROSS_BANKROLL_MULT=1.0
# Resting-order count cap. LatArb is FAK-only so this rarely binds.
MAX_OPEN_ORDERS=4

# -- 9. Loss limits and halts -------------------------------------------------
# Percent-of-bankroll is PRIMARY whenever the balance is known; the dollar
# figure is only the fallback. The cap is taken against *free cash*.
#
# !! WHAT KILLED THE 2026-07-25 SESSION !!
# MAX_DRAWDOWN_FROM_PEAK is no longer ignored. The build used to compute the
# drawdown-from-peak cap as bankroll x MAX_DAILY_LOSS_PCT, i.e. the same number
# as the daily cap, and give-back from a peak is always >= loss from the day's
# start -- so the drawdown rule was strictly tighter than every other limit and
# this file's own 6.0 was silently discarded. On $9.10 the effective cap was
# $2.73, which is LESS THAN ONE WINNING TRADE (+$2.96). The session went
# +2.97, +2.92, -2.06, -2.06 (net +$1.77, i.e. PROFITABLE) and halted anyway on
# "Drawdown $4.12 from peak $5.88 (cap $2.73)", then burned 17h in 2,944
# boot->halt->exit cycles. The build now honours the key below, rebases the peak
# at each daily reset instead of tracking an all-time high-water mark, and lets a
# drawdown halt clear on the daily reset like the other variance halts.
#
# !! SECOND HALT BUG, FOUND IN VERIFICATION ON 2026-07-26 !!
# The daily cap was computed against the LIVE balance, so it shrank with every
# loss: the halt fired at loss > B0*p/(1+p), not B0*p. At PCT 0.35 that is 26%
# of the account, not 35%. A paper session with an $8.00 bankroll halted on a
# single -$2.79 clip against a cap that had quietly fallen to $1.82. The build
# now anchors the budget to the bankroll at the START of the trading day (and
# persists that anchor across restarts), so the number below is the number that
# is actually enforced.
#
# Sizing for the CURRENT $9.10 wallet, where a losing clip costs ~$2.06:
#   MAX_DAILY_LOSS_PCT 0.46 -> $4.19: absorbs 2 losing clips, halts on the 3rd.
#     (0.35 -> $3.19 would stop the day after ONE loss, which is why it moved.)
#   MAX_DRAWDOWN_FROM_PEAK 4.5 -> must stay ABOVE the daily cap, otherwise
#     give-back from a peak (always >= loss from the day's start) makes the
#     drawdown rule fire first and the daily cap unreachable -- that is exactly
#     the 2026-07-25 failure described above.
#   MAX_CONSECUTIVE_LOSSES 4 -> a 3-loss streak is ordinary variance when the
#     break-even win rate is ~44%; 4 in a row without a win is the real signal.
# These percentages are deliberately large because the venue's $2 minimum clip is
# 22% of a $9.10 wallet. THIS IS THE REAL CONSTRAINT: no risk configuration is
# statistically sound at this balance. Fund to $60+ and then use
#   $60 -> PCT 0.20, DRAWDOWN 12, MONTHLY 60      $100 -> PCT 0.12, DRAWDOWN 18, MONTHLY 90
#
# FUNDING TO $60? Change exactly these six lines and nothing else:
#   MIN_ORDER_USDC=3.00           (unchanged - it is the 5-share venue floor)
#   MAX_ORDER_USDC=6.0            (restores Kelly range: must be >= 2x min)
#   MAX_POSITION_USDC=8.0         (>= max_order; validator rejects the reverse)
#   MAX_NET_EXPOSURE_USDC=9.0     (3 correlated clips; <= 0.75 x drawdown cap)
#   MAX_GROSS_EXPOSURE_USDC=12.0
#   MAX_DAILY_LOSS_PCT=0.20  MAX_DRAWDOWN_FROM_PEAK=12.0  MAX_MONTHLY_LOSS=60.0
# The soak used net 24 / gross 32 at $60 and that is what tripped the halt -
# 8 concurrent correlated clips against a $12 drawdown budget. Use 9 / 12.
# [TUNED 2026-07-26] was MAX_DAILY_LOSS=6.0 -> 4.0 -- aligned with the pct cap below (used only as fallback when bankroll is unknown).
MAX_DAILY_LOSS=6.0
# [TUNED 2026-07-26] was 0.55 -> 0.35 -> 0.46. This key OVERRIDES MAX_DAILY_LOSS whenever bankroll is known. 0.46 x $9.10 = $4.19 = two losing $2 clips.
MAX_DAILY_LOSS_PCT=0.65
# monthly_loss is an OPERATOR-ONLY halt: it never auto-clears, so a value the
# wallet can actually reach would brick the bot for the rest of the month.
# Keep it above the wallet balance and let the daily caps do the work.
MAX_MONTHLY_LOSS=30.0
# Now the ACTUAL drawdown-from-peak cap (dollars, intraday, peak rebased daily).
# [TUNED 2026-07-26] was 6.0 -> 4.0 -> 4.5 -- kept strictly ABOVE the $4.19 daily cap so the daily rule binds first (see the note above).
MAX_DRAWDOWN_FROM_PEAK=6.0
MAX_CONSECUTIVE_LOSSES=4
AUTO_FLATTEN_ON_HALT=false

# -- 10. Capital-shock detector ----------------------------------------------
# Own fills are debited locally first, so this fires on external debits only:
# drop >= max(floor, pct x balance).
BALANCE_REFRESH_S=5.0
CAPITAL_SHOCK_PCT=0.08
# [TUNED 2026-07-26] was CAPITAL_SHOCK_FLOOR_USDC=2.0 -- must exceed the largest single own fill. At 2.0 the bot own $2.50 fill was misread as an external withdrawal (false CAPITAL SHOCK 07:55:19).
CAPITAL_SHOCK_FLOOR_USDC=6.0
HALT_ON_CAPITAL_SHOCK=true

# -- 11. Toxicity / adverse selection ----------------------------------------
ADVERSE_SELECT_GATE=true
MAX_ADVERSE_BPS=40.0
ADVERSE_EWMA_ALPHA=0.10
# NEW (R22). The adverse-selection EWMA only moves when a fill arrives, so before
# this release one toxic patch latched the LatArb gate shut: the 2026-07-27 live
# session froze at +151.4bps at 07:16 and skipped 15,315 signals for the next
# 2h50m without a single order. The estimate now decays toward 0 with this
# half-life, so a stale reading stops vetoing trades. 0 disables the decay.
ADVERSE_EWMA_HALFLIFE_S=180.0

# R29 (rev 4): winsorise a single adverse observation at this many bps before it
# enters the EWMA. One +151bps print used to latch the LatArb gate shut for two
# whole market cycles. Must be >= MAX_ADVERSE_BPS; 0 disables.
ADVERSE_EWMA_CLAMP_BPS=120.0
SHADOW_PROBE_ENABLED=true
WHALE_TRADE_USDC=5000.0
WHALE_COOLDOWN_S=3.0

# -- 12. Fees -----------------------------------------------------------------
# Per-market feeRate is used when the venue reports one; CATEGORY_FEE_RATE is
# the fallback coefficient and TAKER_FEE_BPS only applies to zero-fee markets.
CATEGORY_FEE_RATE=0.07
TAKER_FEE_BPS=20.0

# -- 13. Redemption (required before live LatArb) -----------------------------
# validate() rejects live LatArb with REDEEM_ENABLED=false: resolved CTF
# collateral would be stranded. Inert while DRY_RUN=true.
REDEEM_ENABLED=true
# [R10 FIX 2026-07-26] Root cause of the 09:39-09:47 crash loop: polygon-rpc.com
# now answers JSON-RPC POSTs with HTTP 403 {"error":"API key disabled, reason:
# tenant disabled"} -> web3 is_connected()=False -> Web3 init failed -> fatal at
# boot. Measured from a clean host on 2026-07-26: publicnode / drpc / 1rpc all
# return chainId 0x89; polygon-rpc.com 403s; llamarpc has no route; ankr needs a
# key. The bot now probes POLYGON_RPC_URL plus POLYGON_RPC_FALLBACKS with a real
# eth_chainId call and uses the first healthy one, so a single dead vendor can no
# longer stop the bot. Keep at least two entries here.
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
POLYGON_RPC_FALLBACKS=https://polygon.drpc.org,https://1rpc.io/matic,https://polygon-rpc.com
REDEEM_MAX_GAS_GWEI=300.0
# NEW (R19). Polygon bor enforces a MINIMUM priority fee of 25 gwei. The old code
# capped the tip at 2 gwei, so every redemption was rejected by the node
# (-32000 'gas tip cap 2000000000, minimum needed 25000000000') - 144 failed
# retries and zero settled winners converted back to USDC in one session.
# 30 gwei leaves headroom above the 25 gwei floor; raise it if redemptions lag.
REDEEM_MIN_PRIORITY_GWEI=30.0
# Two-leg arb is not depth-walked/atomic in this build; validate() blocks true.
COMPLEMENT_ARB_ENABLED=false

# -- 14. Telemetry ------------------------------------------------------------
CALIBRATION_LOG_PATH=~/calibration_v1959e.csv
CALIBRATION_LOG_ENABLED=true
METRICS_ENABLED=true
DRY_RUN_FILL_PROB=0.7
DRY_RUN_LATENCY_MS=50.0

# -- 15. Event loop / infrastructure ------------------------------------------
EVENT_DRIVEN=true
WS_SHARD_COUNT=2
ORDER_RATE_LIMIT_PER_SEC=12
DISCOVERY_INTERVAL_S=10.0
RECONCILE_FILLS_INTERVAL_S=30.0
DRIFT_HALT_THRESHOLD_SHARES=0.01
DRIFT_CHECK_CONCURRENCY=4
MAX_CONCURRENT_EVALS=5
# Only used when EVENT_DRIVEN=false (timer fallback loop).
STRATEGY_INTERVAL_S=1.5

# -- 16. Resilience knobs (added 2026-07-26) ----------------------------------
# Bounded wait for a stale instance lock instead of exiting instantly. The
# supervisor restart races the dying process; 20s covers a normal shutdown.
INSTANCE_LOCK_WAIT_S=20
# Binance market-data endpoints. api.binance.com / stream.binance.com return
# HTTP 451 from some hosting regions (AWS eu/us edge included). The bot falls
# back to the public data mirrors automatically; set these to pin them.
# BINANCE_WS_URL=wss://data-stream.binance.vision/stream
# BINANCE_REST_URL=https://data-api.binance.vision
# Paper bankroll used ONLY when DRY_RUN=true and the wallet holds less than the
# sizing floor, so paper runs still size orders. Live runs always use the real
# on-chain balance.
DRY_RUN_BANKROLL_USDC=8.0
# R16: paper mode only. A market that resolved while the bot was down cannot be
# settled from oracle history the bot never recorded, so after this many seconds
# past the interval close the paper position is closed FLAT at cost (realized 0,
# never an invented win) and the paper capital recycles. Live settlement is always
# taken from the on-chain redemption receipt and is never estimated.
DRY_STALE_SETTLE_S=600

# R28 (rev 4): full REST re-snapshot cadence per token, in seconds. Drift
# detected against the venue's own best_bid/best_ask repairs immediately;
# this is the belt-and-braces sweep. 0 disables the periodic sweep.
BOOK_RESYNC_S=120.0
