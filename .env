###############################################################################
# opus5.py — tuned live configuration  (revision R26/R27/R28, 2026-07-28)
#
# Every value that differs from your previous .env is marked  ### CHANGED ###
# with the reason. Nothing else was touched.
#
# ---------------------------------------------------------------------------
# READ THIS FIRST — the one thing config cannot fix
# ---------------------------------------------------------------------------
# Your 2026-07-27 run had a CLOB balance of $3.3935 and MIN_ORDER_USDC=3.00.
# After a single $3.03 entry, free cash was $0.39, and the bot logged
#   LATARB_SKIP [bankroll] min_order $3.00 > bankroll $0.3935 * frac 0.90
# 1,101 times. The venue floor is 5 shares (~$3.00 at a 0.60 ask), so $3.00 is
# genuinely the smallest order that can exist — the account was funded for
# exactly one trade. This file is sized for a WORKING BALANCE OF $150 USDC.
# If you deposit a different amount, scale the six values under RISK CAPS
# linearly with it and leave everything else alone.
###############################################################################

# --- Identity / venue --------------------------------------------------------
POLYMARKET_PRIVATE_KEY=
POLYMARKET_PROXY_ADDRESS=0xdC115aF17dB9F6DBB54E83B9C1bD661B2B9713d9
POLYMARKET_SIGNATURE_TYPE=2
CLOB_URL=https://clob.polymarket.com
GAMMA_URL=https://gamma-api.polymarket.com
CHAIN_ID=137
DRY_RUN=false
MEASURE_ONLY=
LOG_LEVEL=INFO
COINS=BTC,ETH,SOL

# --- Latency-arb signal ------------------------------------------------------
# Unchanged on purpose. Two live fills is not a sample; re-tuning the edge or
# probability floor on it would be curve-fitting. LATARB live-proof (below)
# holds size at the minimum until the fill + settlement ledgers earn the size.
LATENCY_ARB_ENABLED=true
LATENCY_ARB_EDGE=0.020
LATENCY_ARB_MIN_PROB=0.58
LATENCY_ARB_COOLDOWN_S=2.0
MIN_TOP_BOOK_USDC=6.0
MAX_SPREAD_PCT=0.10
MAX_BOOK_AGE_MS=500
ENTRY_MODE=taker

# --- Shadow / calibration ledgers -------------------------------------------
LATARB_SHADOW=true
LATARB_SHADOW_PATH=~/latarb_shadow_v1959e.csv
LATARB_SHADOW_MIN_AGE_MS=0
LATARB_SHADOW_THROTTLE_MS=500.0
LATARB_SHADOW_MAX_AGE_MS=250.0
LATARB_FILLS_PATH=~/latarb_fills_v1959e.jsonl
LATARB_SETTLE_PATH=~/latarb_settle_v1959e.jsonl
CALIBRATION_LOG_PATH=~/calibration_v1959e.csv
CALIBRATION_LOG_ENABLED=true

# --- Live proof (keep ON) ----------------------------------------------------
# This is the control that stops an unproven edge from being sized up. Leave it
# true. R28 makes the fill statistics it reads honest: a dust match no longer
# reports as a 100%-filled attempt.
REQUIRE_LATARB_LIVE_PROOF=true
LATARB_BOOTSTRAP_LIVE=true
LATARB_MIN_LIVE_ATTEMPTS=50
LATARB_MIN_LIVE_FILL_RATE=0.40
LATARB_MIN_SETTLE_SAMPLES=20
LATARB_MIN_SETTLE_WIN_RATE=0.52
LATARB_MIN_SETTLE_PNL=0.0
LATARB_KILL_SWITCH_MIN_FILL_RATE=0.20
LATARB_MIN_PROVEN_SIGNALS=200
LATARB_MIN_WIN_RATE=0.54
LATARB_MIN_TOTAL_PNL=0.0

# --- Order sizing ------------------------------------------------------------
MIN_ORDER_USDC=3.00
MAX_ORDER_USDC=12.0
### CHANGED ### was 4.0. The bot warned on every boot:
#   "max_order_size ($4.0) < 2x min_order_size ($3.0) — Kelly sizing is
#    effectively disabled; all trades will fire at the venue minimum"
# 12.0 is 4x the minimum, so depth-limited sizing (_fak_limit_and_size) and
# Kelly can actually express a size. Still only 8% of a $150 balance per clip.
MAX_POSITION_USDC=12.0
### CHANGED ### was 4.0, i.e. equal to one order. That is why the live log shows
# LATARB_SKIP [position_cap] "market total $3.03 + min $3.00 > max_position
# $4.00" 265 times: the first fill closed the market to any follow-up. Must be
# >= MAX_ORDER_USDC (config validator) and should leave room to add.
MAX_BANKROLL_FRACTION=0.20
### CHANGED ### was 0.90. Ninety percent of the bankroll in one clip is not a
# risk limit. 0.20 of $150 = $30, so MAX_ORDER_USDC ($12) stays the binding
# constraint, which is the intended ordering.

# --- RISK CAPS (scale these six linearly with your deposit) ------------------
MAX_NET_EXPOSURE_USDC=45.0
### CHANGED ### was 6.0 (sized for the $3.39 account).
MAX_GROSS_EXPOSURE_USDC=60.0
### CHANGED ### was 8.0.
MAX_DAILY_LOSS=15.0
### CHANGED ### was 6.0. 10% of the $150 working balance.
MAX_DAILY_LOSS_PCT=0.10
### CHANGED ### was 0.65. A 65% single-day loss allowance is not a control;
# whichever of MAX_DAILY_LOSS / MAX_DAILY_LOSS_PCT binds first should be ~10%.
MAX_MONTHLY_LOSS=45.0
### CHANGED ### was 30.0 — kept at 3x the daily cap.
MAX_DRAWDOWN_FROM_PEAK=15.0
### CHANGED ### was 6.0 — kept equal to the daily cap.

MAX_NET_BANKROLL_MULT=1.0
MAX_GROSS_BANKROLL_MULT=1.0
MAX_OPEN_ORDERS=4
MAX_CONSECUTIVE_LOSSES=4
AUTO_FLATTEN_ON_HALT=false
BALANCE_REFRESH_S=5.0
CAPITAL_SHOCK_PCT=0.08
CAPITAL_SHOCK_FLOOR_USDC=6.0
HALT_ON_CAPITAL_SHOCK=true

# --- Adverse selection gate --------------------------------------------------
# Unchanged. R28 is what makes this gate usable: previously a single dust fill
# wrote a +367bps sample (clamped to +120bps) into the EWMA, which sits above
# MAX_ADVERSE_BPS=40 and would have throttled every subsequent entry.
ADVERSE_SELECT_GATE=true
MAX_ADVERSE_BPS=40.0
ADVERSE_EWMA_ALPHA=0.10
ADVERSE_EWMA_HALFLIFE_S=180.0
ADVERSE_EWMA_CLAMP_BPS=120.0
SHADOW_PROBE_ENABLED=true
WHALE_TRADE_USDC=5000.0
WHALE_COOLDOWN_S=3.0

# --- Fees --------------------------------------------------------------------
CATEGORY_FEE_RATE=0.07
TAKER_FEE_BPS=20.0

# --- Redemption / RPC --------------------------------------------------------
# Unchanged. The 30 gwei priority floor (R19) is required by Polygon bor and
# the fallback pool is what keeps a provider blip from being fatal. R26 now
# lets a 'redemption' halt clear itself once the boot receipt sweep resolves.
REDEEM_ENABLED=true
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
POLYGON_RPC_FALLBACKS=https://polygon.drpc.org,https://1rpc.io/matic,https://polygon-rpc.com
REDEEM_MAX_GAS_GWEI=300.0
REDEEM_MIN_PRIORITY_GWEI=30.0

# --- Engine ------------------------------------------------------------------
COMPLEMENT_ARB_ENABLED=false
METRICS_ENABLED=true
DRY_RUN_FILL_PROB=0.7
DRY_RUN_LATENCY_MS=50.0
EVENT_DRIVEN=true
WS_SHARD_COUNT=2
ORDER_RATE_LIMIT_PER_SEC=12
DISCOVERY_INTERVAL_S=10.0
RECONCILE_FILLS_INTERVAL_S=30.0
DRIFT_HALT_THRESHOLD_SHARES=0.01
DRIFT_CHECK_CONCURRENCY=4
MAX_CONCURRENT_EVALS=5
STRATEGY_INTERVAL_S=1.5
INSTANCE_LOCK_WAIT_S=20
DRY_RUN_BANKROLL_USDC=8.0
DRY_STALE_SETTLE_S=600
BOOK_RESYNC_S=120.0

# Optional: only set these if your host is geo-blocked from Binance. The code
# already falls back to the .vision mirrors automatically (verified working
# from a blocked host during this review), so leave them unset unless needed.
# BINANCE_WS_URL=wss://data-stream.binance.vision
# BINANCE_REST_URL=https://data-api.binance.vision
